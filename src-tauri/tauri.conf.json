{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "topica",
  "version": "0.1.0",
  "identifier": "com.iyulab.topica",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Topica",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/Topica.Api"],
    "resources": {
      "binaries/*.dll": ".",
      "binaries/*.so": ".",
      "binaries/*.dylib": ".",
      "binaries/*.json": ".",
      "binaries/*.dat": "."
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQzY4REY5NzI0N0JFMzUKUldRMXZrZHkrWTNHTHhaUU1VMERUWm9hcWllb2pHcnRCV1E0SFJPY08wVE9EME5Kc2NOTGtUVDkK",
      "endpoints": [
        "https://github.com/iyulab/topica/releases/latest/download/latest.json"
      ]
    }
  }
}
